# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./sathyamithra.db
# For PostgreSQL: postgresql+asyncpg://sathya_user:sathya_password@localhost:5432/sathyamithra_db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# JWT Security
JWT_SECRET=sathyamithra_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models & Keys (Phase 4)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Storage (Phase 5)
STORAGE_BUCKET=sathyamithra-docs
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
